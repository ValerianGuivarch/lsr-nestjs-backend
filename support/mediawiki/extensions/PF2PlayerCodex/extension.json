{
  "name": "PF2PlayerCodex",
  "version": "0.3.1",
  "author": [
    "PF2 project"
  ],
  "description": "Carnet joueur PF2, séparé du référentiel MJ.",
  "type": "other",
  "AutoloadClasses": {
    "PF2PlayerCodexHooks": "includes/PF2PlayerCodexHooks.php",
    "ApiPF2PlayerCodex": "includes/ApiPF2PlayerCodex.php",
    "ApiPF2PlayerCodexUpdate": "includes/ApiPF2PlayerCodexUpdate.php",
    "ApiPF2PlayerCodexMe": "includes/ApiPF2PlayerCodexMe.php",
    "ApiPF2PlayerCodexMeUpdate": "includes/ApiPF2PlayerCodexMeUpdate.php",
    "SpecialPF2MyCharacters": "includes/SpecialPF2MyCharacters.php"
  },
  "APIModules": {
    "pf2playercodex": "ApiPF2PlayerCodex",
    "pf2playercodexupdate": "ApiPF2PlayerCodexUpdate",
    "pf2playercodexme": "ApiPF2PlayerCodexMe",
    "pf2playercodexmeupdate": "ApiPF2PlayerCodexMeUpdate"
  },
  "ResourceModules": {
    "ext.pf2playercodex": {
      "scripts": [
        "resources/pf2-player-codex.js"
      ],
      "styles": [
        "resources/pf2-player-codex.css"
      ],
      "dependencies": [
        "mediawiki.api",
        "mediawiki.util"
      ],
      "localBasePath": "",
      "remoteExtPath": "PF2PlayerCodex"
    }
  },
  "Hooks": {
    "BeforePageDisplay": "PF2PlayerCodexHooks::onBeforePageDisplay"
  },
  "config": {
    "PF2PlayerCodexApiBase": {
      "value": "http://host.docker.internal:3333/api/pf2-mj"
    }
  },
  "manifest_version": 2,
  "SpecialPages": {
    "MesPersonnages": "SpecialPF2MyCharacters"
  }
}
