{
  "name": "PF2Sessions",
  "version": "0.5.0",
  "author": [
    "PF2 project"
  ],
  "url": "https://wiki.l7r.fr",
  "descriptionmsg": "pf2sessions-desc",
  "type": "other",
  "AutoloadClasses": {
    "PF2SessionsHooks": "includes/PF2SessionsHooks.php",
    "ApiPF2Sessions": "includes/ApiPF2Sessions.php",
    "ApiPF2SessionUpdate": "includes/ApiPF2SessionUpdate.php",
    "ApiPF2SessionPreview": "includes/ApiPF2SessionPreview.php",
    "ApiPF2SessionPublication": "includes/ApiPF2SessionPublication.php",
    "ApiPF2SessionDelete": "includes/ApiPF2SessionDelete.php",
    "SpecialPF2DiscordLogin": "includes/SpecialPF2DiscordLogin.php",
    "ApiPF2SessionXp": "includes/ApiPF2SessionXp.php",
    "SpecialPF2SessionXp": "includes/SpecialPF2SessionXp.php"
  },
  "SpecialPages": {
    "PF2DiscordLogin": "SpecialPF2DiscordLogin",
    "PF2SessionXp": "SpecialPF2SessionXp"
  },
  "APIModules": {
    "pf2sessions": "ApiPF2Sessions",
    "pf2sessionupdate": "ApiPF2SessionUpdate",
    "pf2sessionpreview": "ApiPF2SessionPreview",
    "pf2sessionpublication": "ApiPF2SessionPublication",
    "pf2sessiondelete": "ApiPF2SessionDelete",
    "pf2sessionxp": "ApiPF2SessionXp"
  },
  "ResourceModules": {
    "ext.pf2sessions": {
      "scripts": [
        "resources/pf2-sessions.js"
      ],
      "styles": [
        "resources/pf2-sessions.css"
      ],
      "dependencies": [
        "mediawiki.api",
        "mediawiki.util"
      ],
      "localBasePath": "",
      "remoteExtPath": "PF2Sessions"
    },
    "ext.pf2sessions.xp": {
      "scripts": [
        "resources/pf2-session-xp-calc.js",
        "resources/pf2-session-xp.js"
      ],
      "styles": [
        "resources/pf2-session-xp.css"
      ],
      "dependencies": [
        "mediawiki.api",
        "mediawiki.util"
      ],
      "localBasePath": "",
      "remoteExtPath": "PF2Sessions"
    }
  },
  "Hooks": {
    "BeforePageDisplay": "PF2SessionsHooks::onBeforePageDisplay"
  },
  "MessagesDirs": {
    "PF2Sessions": [
      "i18n"
    ]
  },
  "config": {
    "PF2SessionsApiBase": {
      "value": "http://host.docker.internal:3333/api/pf2-mj"
    }
  },
  "manifest_version": 2,
  "AvailableRights": [
    "pf2sessions-admin"
  ],
  "GroupPermissions": {
    "sysop": {
      "pf2sessions-admin": true
    }
  }
}
