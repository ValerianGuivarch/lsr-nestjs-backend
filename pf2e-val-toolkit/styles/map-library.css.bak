.pf2e-val-map-library-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 12px;
  min-width: min(680px, 75vw);
  padding: 4px 0;
}

.pf2e-val-map-library-card {
  display: flex;
  flex-direction: column;
  gap: 8px;
  align-items: stretch;
  padding: 8px;
  border: 1px solid var(--color-border-light-2, #777);
  border-radius: 6px;
  background: var(--color-cool-5-75, rgba(20, 20, 30, 0.65));
  cursor: pointer;
  text-align: center;
}

.pf2e-val-map-library-card:hover {
  box-shadow: 0 0 0 1px var(--color-warm-1, #d9a441);
}

.pf2e-val-map-library-card img {
  width: 100%;
  aspect-ratio: 16 / 10;
  object-fit: cover;
  border: 0;
  border-radius: 4px;
}

.pf2e-val-map-library-card span {
  font-weight: 600;
}
